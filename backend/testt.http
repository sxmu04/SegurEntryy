#####################################################
### USUARIOS
#####################################################

### Crear usuario
POST {{baseUrl}}/users/create/
Content-Type: application/json

{
    "name": "Juan Pérez",
    "email": "jkest0725@gmail.com",
    "password": "Admin123456",
    "invitation_code": "15YUFMFX"
}

###

### Obtener usuario
GET {{baseUrl}}/users/get/1UeoO2fYNabC4ogloesQM4H7v2J2/

###

### Listar usuarios
GET {{baseUrl}}/users/list/

###

### Actualizar usuario
PUT {{baseUrl}}/users/update/1UeoO2fYNabC4ogloesQM4H7v2J2/
Content-Type: application/json

{
    "name": "Juan Actualizado",
    "email": "nuevo@gmail.com",
    "role": "admin",
    "active": true
}

###

### Cambiar contraseña
PUT {{baseUrl}}/users/update/1UeoO2fYNabC4ogloesQM4H7v2J2/
Content-Type: application/json

{
    "password": "NuevaPassword123"
}

###

### Eliminar usuario
DELETE {{baseUrl}}/users/delete/1UeoO2fYNabC4ogloesQM4H7v2J2/

